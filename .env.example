# URL de produção do site (sem barra no final) — usada pelo webhook da
# Hubla para montar o link de convite que vai por e-mail para quem comprou.
NEXT_PUBLIC_SITE_URL=https://verticeia.vercel.app

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Nunca exponha esta chave no client. Só é usada em app/api/webhooks/hubla/route.ts.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Panda Video — a URL do player muda por conta, algo como:
# https://player-vz-XXXXXXXX-XXX.tv.pandavideo.com.br
NEXT_PUBLIC_PANDA_PLAYER_BASE_URL=

# Link de checkout da Hubla para o card de upsell da Implementação (R$1.500)
NEXT_PUBLIC_IMPLEMENTACAO_CHECKOUT_URL=

# Token do webhook — cadastre este valor no painel da Hubla ao criar o
# webhook, a Hubla vai reenviá-lo no header x-hubla-token em toda chamada.
# Gere um valor aleatório forte, ex: openssl rand -hex 32
HUBLA_WEBHOOK_TOKEN=

# Link usado no botão "Precisa de ajuda?" da página de produto — pode ser
# um link de WhatsApp (ex: https://wa.me/5511999999999), um "mailto:..."
# ou qualquer outro link de suporte. Se ficar vazio, o botão não aparece.
NEXT_PUBLIC_SUPPORT_URL=
