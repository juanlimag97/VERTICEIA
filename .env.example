# URL de produção do site (sem barra no final) — usada pelo webhook da
# Hubla para montar o link de convite que vai por e-mail para quem comprou.
NEXT_PUBLIC_SITE_URL=https://verticeia.vercel.app

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Nunca exponha esta chave no client. Só é usada em app/api/webhooks/hubla/route.ts.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Cloudflare R2 (armazenamento dos vídeos — gratuito, sem custo de banda).
# Pegue esses valores em Cloudflare → R2 → Manage R2 API Tokens.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Link de checkout da Hubla para o card de upsell da Implementação (R$1.500)
NEXT_PUBLIC_IMPLEMENTACAO_CHECKOUT_URL=

# Token do webhook — cadastre este valor no painel da Hubla ao criar o
# webhook, a Hubla vai reenviá-lo no header x-hubla-token em toda chamada.
# Gere um valor aleatório forte, ex: openssl rand -hex 32
HUBLA_WEBHOOK_TOKEN=

# Link usado no botão "Precisa de ajuda?" da página de produto (e também
# no botão de WhatsApp da página /inicio) — pode ser um link de WhatsApp
# (ex: https://wa.me/5511999999999), um "mailto:..." ou qualquer outro
# link de suporte. Se ficar vazio, os botões que dependem dele somem.
NEXT_PUBLIC_SUPPORT_URL=

# Página /inicio — link da bio do Instagram (ver README para detalhes)
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/seu_perfil

# Link de checkout da Hubla do Vértice IA (SDR), usado nos botões
# "Quero meu SDR" da página /inicio. Se ficar vazio, aponta pra "#".
# Os outros produtos (Perfil que Converte, Reputação 5 Estrelas,
# Formatos de Criativo) são order bump — só aparecem no checkout da
# Hubla, não têm botão na página /inicio.
NEXT_PUBLIC_CHECKOUT_VERTICE_IA=

# Link do grupo de avisos no WhatsApp, mostrado na página /obrigado
# (pós-compra). Se ficar vazio, esse passo some da página.
NEXT_PUBLIC_WHATSAPP_GROUP_URL=
